# Copy to .env and fill in. docker-compose reads FRED_API_KEY automatically;
# the others are for running things outside docker (see README.md).

# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
# Without this, load_fundamentals.py refuses to run (COT and futures still work).
FRED_API_KEY=

# Only needed if running the API/ETL outside docker compose.
DATABASE_URL=postgresql://lbrpit:lbrpit@localhost:5432/lbrpit
# LBR_PIT_DATA_DIR defaults to ./data (source CSVs ship in the repo); only
# set this to point somewhere else.
